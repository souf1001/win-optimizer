{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Win Optimizer",
  "version": "0.1.0",
  "identifier": "dev.winoptimizer.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Win Optimizer",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Win Optimizer",
    "shortDescription": "Windows optimizer for gaming and everyday use",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
